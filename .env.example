APP_NAME=VELORA
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=velora
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=public

# MAIL_MAILER=log writes emails (including the registration OTP) to
# storage/logs/laravel.log instead of actually sending them — fine for local
# testing, but registration needs a real mailer for the OTP to land in an
# actual inbox. Example for Gmail (use an App Password, not your real
# password): https://support.google.com/mail/answer/185833
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=youraddress@gmail.com
# MAIL_PASSWORD="your 16-character app password"
# MAIL_ENCRYPTION=tls
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@velora.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
